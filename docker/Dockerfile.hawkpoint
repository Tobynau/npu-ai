# Environment for reference/hawkpoint-npu-llm on top of npu-ai:latest.
# The project pins CPython 3.12, mlir-aie at git 57d7494e99c (2026-07-28), Peano llvm-aie
# 21.0.0.2026072001 and hash-locked Python deps (requirements.lock).
# mlir-aie wheel: the v1.4.0 release (one day / ten commits later) already contains the IRON Runtime
# rework (#3387, Runtime(seq_fn)) which breaks every hawkpoint design, so we use the per-commit CI wheel
# 1.3.5.dev115+gc69e4c3 from the "latest-wheels-4" release: three commits before the pin (a packet-flow
# routing pass, Windows test fixes, a cmake bump), same Python API.
# Ubuntu's python3-xrt is built for 3.14 only, so pyxrt is compiled here from the XRT 2.21.75 source.
FROM npu-ai:latest
USER root
ARG DEBIAN_FRONTEND=noninteractive

COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
ENV UV_NO_CACHE=1
RUN uv python install 3.12 && uv venv --python 3.12 --seed /opt/venv312

# 1. hash-locked project dependencies (numpy 2.5.4, tokenizers 0.23.3, safetensors 0.8.0, ml-dtypes 0.6.0, huggingface-hub 1.33.0, ...)
COPY hawkpoint-requirements.lock /tmp/requirements.lock
RUN uv pip install --python /opt/venv312/bin/python --require-hashes -r /tmp/requirements.lock && rm /tmp/requirements.lock

# 2. mlir-aie per-commit wheel (cp312) + Peano pinned to the build the project validated with
ARG MLIR_AIE_WHEEL=mlir_aie-1.3.5.dev115+gc69e4c3-cp312-cp312-manylinux_2_35_x86_64.whl
COPY "wheels/${MLIR_AIE_WHEEL}" /tmp/wheels/
RUN uv pip install --python /opt/venv312/bin/python "/tmp/wheels/${MLIR_AIE_WHEEL}" && rm -rf /tmp/wheels
ARG PEANO_PIN=llvm-aie==21.0.0.2026072001+ce8c0f8f
RUN uv pip install --python /opt/venv312/bin/python "${PEANO_PIN}" \
      -f https://github.com/Xilinx/llvm-aie/releases/expanded_assets/nightly

# 3. pyxrt for CPython 3.12 from the XRT 2.21.75 pybind11 source (see pyxrt/README.md)
RUN apt-get update && apt-get install -y --no-install-recommends libboost-dev && rm -rf /var/lib/apt/lists/*
COPY pyxrt/pyxrt.cpp /tmp/pyxrt/pyxrt.cpp
RUN uv pip install --python /opt/venv312/bin/python pybind11 \
    && PY=/opt/venv312/bin/python \
    && SUFFIX=$($PY -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX"))') \
    && g++ -O2 -shared -fPIC -std=c++17 -fvisibility=hidden $($PY -m pybind11 --includes) \
         /tmp/pyxrt/pyxrt.cpp -o /opt/venv312/lib/python3.12/site-packages/pyxrt${SUFFIX} \
         -lxrt_coreutil -luuid -lpthread \
    && rm -rf /tmp/pyxrt

# 4. /opt/xilinx/xrt layout as symlinks to the distro install, only for the project's hardware probe
#    (scripts/verify_hardware_versions.py compiles a C++ probe against $XILINX_XRT/include and lib64).
#    Not exported globally: with XILINX_XRT set, XRT's loader wants $XILINX_XRT/lib/x86_64-linux-gnu/
#    libxrt_core.so.2, hence lib -> /usr/lib; scripts/10-llm-hawkpoint.sh sets it for the probe only.
#    include/ holds only the xrt/ headers: pointing it at /usr/include itself breaks g++'s `#include_next`
#    ordering once the probe passes `-isystem $XILINX_XRT/include`.
RUN mkdir -p /opt/xilinx/xrt/include && ln -s /usr/include/xrt /opt/xilinx/xrt/include/xrt && ln -s /usr/lib /opt/xilinx/xrt/lib \
    && ln -s /usr/lib/x86_64-linux-gnu /opt/xilinx/xrt/lib64 && ln -s /usr/bin /opt/xilinx/xrt/bin

# 5. Toolchain for the project's two other XDNA1 runtimes (ollama-xdna/ and colibri-xdna/, driven by
#    scripts/11-llm-hawkpoint-ollama-colibri.sh). Ollama v0.33.3 needs Go >= 1.26 (taken from go.dev, checksum
#    pinned), its scripts want jq and ccache; cmake 4.2, ninja, g++ 15, pkg-config and pciutils are already in
#    the base image, and verify-system.sh / colibri build.sh find the XRT headers and libxrt_coreutil.so through
#    the /opt/xilinx/xrt shim above (libxrt-dev is installed). Nothing is installed on the host.
ARG GO_VERSION=1.26.9
ARG GO_SHA256=42d158b4d8f7b61ac0a830567c940a86098fb7aac52e467a5ebec03ef5cc2f8d
RUN apt-get update && apt-get install -y --no-install-recommends jq ccache && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    && echo "${GO_SHA256}  /tmp/go.tgz" | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz && /usr/local/go/bin/go version

ENV VIRTUAL_ENV=/opt/venv312
ENV MLIR_AIE_INSTALL_DIR=/opt/venv312/lib/python3.12/site-packages/mlir_aie
ENV PEANO_INSTALL_DIR=/opt/venv312/lib/python3.12/site-packages/llvm-aie
ENV PATH=/opt/venv312/bin:${MLIR_AIE_INSTALL_DIR}/bin:${PEANO_INSTALL_DIR}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/go/bin
ENV LD_LIBRARY_PATH=${MLIR_AIE_INSTALL_DIR}/lib
ENV PYTHONUNBUFFERED=1
RUN python -c "import sys, aie, pyxrt, numpy, tokenizers, safetensors, ml_dtypes, huggingface_hub; \
print('python', sys.version.split()[0], '| aie', aie.__file__); print('pyxrt', pyxrt.__file__)" \
    && python -m pip --version >/dev/null 2>&1 || true \
    && uv pip list --python /opt/venv312/bin/python | grep -Ei "^(mlir-aie|llvm-aie|numpy|tokenizers|safetensors|ml-dtypes|huggingface-hub|pybind11) " \
    && ls "${PEANO_INSTALL_DIR}/bin/clang" "${MLIR_AIE_INSTALL_DIR}/bin/aie-opt"

USER npu
WORKDIR /work
CMD ["/bin/bash"]
